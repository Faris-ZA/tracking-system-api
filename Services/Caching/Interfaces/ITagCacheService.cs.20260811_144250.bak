using WebApplication2.DTOs.Tags;

namespace WebApplication2.Services.Caching.Interfaces
{
    public interface ITagCacheService
    {
        Task<TagResponseDto?> GetByIdAsync(
            int tagId);

        Task SetAsync(
            TagResponseDto tag);

        Task SetBatchAsync(
            List<TagResponseDto> tags);

        Task RemoveAsync(
            int tagId);

        Task<List<int>> GetPageIdsAsync(
            int pageNumber,
            int pageSize);

        Task<List<TagResponseDto>> GetPageAsync(
            int pageNumber,
            int pageSize);

        Task<long> GetCountAsync();

        Task<List<TagResponseDto>> GetAssignedPageAsync(
            int pageNumber,
            int pageSize);

        Task<List<TagResponseDto>> GetUnassignedPageAsync(
            int pageNumber,
            int pageSize);

        Task<long> GetAssignedCountAsync();

        Task<long> GetUnassignedCountAsync();

        Task<List<TagResponseDto>> GetByLabelAsync(
            string tagLabel,
            int pageNumber,
            int pageSize);

        Task<long> GetLabelCountAsync(
            string tagLabel);
    }
}