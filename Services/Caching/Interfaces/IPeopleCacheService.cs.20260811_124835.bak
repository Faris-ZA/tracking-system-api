using WebApplication2.DTOs.People;

namespace WebApplication2.Services.Caching.Interfaces
{
    public interface IPeopleCacheService
    {
        Task<PersonResponseDto?> GetByIdAsync(
            int personId);

        Task SetAsync(
            PersonResponseDto person);

        Task SetBatchAsync(
            List<PersonResponseDto> people);

        Task RemoveAsync(
            int personId);

        Task<List<int>> GetPageIdsAsync(
            int pageNumber,
            int pageSize);

        Task<List<PersonResponseDto>> GetPageAsync(
            int pageNumber,
            int pageSize);

        Task<long> GetCountAsync();

        Task<List<PersonResponseDto>> GetAssignedPageAsync(
            int pageNumber,
            int pageSize);

        Task<List<PersonResponseDto>> GetUnassignedPageAsync(
            int pageNumber,
            int pageSize);

        Task<long> GetAssignedCountAsync();

        Task<long> GetUnassignedCountAsync();
    }
}